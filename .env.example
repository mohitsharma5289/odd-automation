# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=odd
POSTGRES_PASSWORD=oddpassword
POSTGRES_DB=odd_automation

DATABASE_URL=postgresql+asyncpg://odd:oddpassword@db:5432/odd_automation
DATABASE_SYNC_URL=postgresql://odd:oddpassword@db:5432/odd_automation

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_SOFT_TIME_LIMIT=1800
CELERY_TIME_LIMIT=2100

# ── ILD Engine (scope filters; case-insensitive) ─────────────────────────────
PRR_NAME_MAX_LEN=16
# PRR scope: rule name must START WITH any prefix AND END WITH any suffix
# (comma-separated lists; empty prefix list disables the prefix check)
PRR_SCOPE_PREFIXES=ild
PRR_SCOPE_SUFFIXES=s6a
# RBAR scope: destination prefix+suffix rules PER DRA CATEGORY (JSON).
# "default" applies to any category without its own entry
# (Core / IoT / Charging / Layer / DR -> orcl...vdea ; Policy -> jio...pcrf)
RBAR_SCOPE_RULES={"default": {"prefixes": ["orcl"], "suffixes": ["vdea"]}, "Policy": {"prefixes": ["jio"], "suffixes": ["pcrf"]}}

# ── Paths (inside containers; mapped to volumes in docker-compose) ───────────
EXPORT_PATH=/app/exports
DUMP_INCOMING_PATH=/app/dumps/incoming
DUMP_PROCESSED_PATH=/app/dumps/processed
UPLOAD_PATH=/app/uploads/requests
DUMP_UPLOAD_PATH=/app/uploads/dumps

# ── Dump source (pluggable) ───────────────────────────────────────────────────
# folder = scan DUMP_INCOMING_PATH; layout nested = {dra_type}/{instance_label}/file.csv
DUMP_SOURCE_TYPE=folder
DUMP_SOURCE_LAYOUT=nested
# Only for DUMP_SOURCE_LAYOUT=flat — named groups (?P<dra_type>) (?P<instance_label>)
DUMP_FILENAME_INSTANCE_REGEX=

# ── Scheduling (HH:MM IST) ────────────────────────────────────────────────────
RECON_CRON_TIME=02:00
DUMP_INGEST_TIMES=06:00,18:00

# ── API ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost,http://localhost:5173
MAX_PAGE_SIZE=200

# ── Redis pub/sub tuning ──────────────────────────────────────────────────────
REDIS_RETRY_COUNT=3
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5.0
REDIS_CONNECT_TIMEOUT=5.0
